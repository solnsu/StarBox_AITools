{
  "name": "starbox",
  "productName": "StarBox",
  "version": "0.2.0",
  "description": "Local ChatGPT, Codex, and DeepSeek credential and gateway management desktop application",
  "author": "solnsu <soln0708@163.com>",
  "homepage": "https://github.com/solnsu/StarBox_AITools",
  "repository": {
    "type": "git",
    "url": "https://github.com/solnsu/StarBox_AITools.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev:desktop": "npm run build:electron && concurrently -k -n web,desktop -c magenta,cyan \"npm:dev:web\" \"wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "esbuild src/electron/main.ts src/electron/preload.ts --bundle --platform=node --format=cjs --packages=external --external:electron --outdir=dist/electron --out-extension:.js=.cjs",
    "desktop:pack": "node scripts/build-desktop.mjs --dir",
    "desktop:dist": "node scripts/build-desktop.mjs",
    "desktop:dist:mac": "node scripts/build-desktop.mjs --mac dmg --arm64 --x64",
    "desktop:dist:win": "node scripts/build-desktop.mjs --win nsis zip --x64",
    "verify:store": "node scripts/verify-store-env.mjs",
    "desktop:dist:store": "node scripts/build-store.mjs",
    "verify:signing:mac": "node scripts/verify-signing-env.mjs mac",
    "verify:signing:win": "node scripts/verify-signing-env.mjs win",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.539.0",
    "ogl": "^1.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "42.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.solnsu.starbox",
    "productName": "StarBox",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "files": [
      "dist/electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/web",
        "to": "web"
      },
      {
        "from": "src/web/public/favicon.png",
        "to": "icon.png"
      },
      {
        "from": "pricing/model-pricing.json",
        "to": "pricing/model-pricing.json"
      },
      {
        "from": "docs/legal/EULA.txt",
        "to": "EULA.txt"
      },
      {
        "from": "docs/legal/EULA_EN.txt",
        "to": "EULA_EN.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "docs/ACKNOWLEDGEMENTS.md",
        "to": "ACKNOWLEDGEMENTS.md"
      },
      {
        "from": "docs/legal/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "docs/legal/PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": ".github/SECURITY.md",
        "to": "SECURITY.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "src/web/public/favicon.png",
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "src/web/public/favicon.png",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "docs/legal/EULA.txt"
    },
    "dmg": {
      "license": "docs/legal/EULA_EN.txt"
    }
  }
}
